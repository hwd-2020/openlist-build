+// rcloneChunkMarker is what rclone's chunker appends to every part name.
+const rcloneChunkMarker = ".rclone_chunk."
+
+// parseRclonePart splits "<base>.rclone_chunk.001" into "<base>" and 1.
+// The temporary objects rclone leaves behind when a move fails
+// ("<base>.rclone_chunk.001_ab12cd") are rejected because the suffix is not
+// purely numeric.
+func parseRclonePart(name string) (string, int, bool) {
+	i := strings.LastIndex(name, rcloneChunkMarker)
+	if i <= 0 {
+		return "", 0, false
+	}
+	suffix := name[i+len(rcloneChunkMarker):]
+	if len(suffix) < 3 {
+		return "", 0, false
+	}
+	for _, c := range suffix {
+		if c < '0' || c > '9' {
+			return "", 0, false
+		}
+	}
+	idx, err := strconv.Atoi(suffix)
+	if err != nil {
+		return "", 0, false
+	}
+	return name[:i], idx, true
+}
+
+func (d *Chunk) getRcloneChunkObject(ctx context.Context, remoteStorage driver.Driver, remoteDir, name, reqPath string) (model.Obj, error) {
+	objs, err := op.List(ctx, remoteStorage, remoteDir, model.ListArgs{})
+	if err != nil {
+		return nil, err
+	}
+	parts := make(map[int]model.Obj)
+	for _, obj := range objs {
+		if obj.IsDir() {
+			continue
+		}
+		if base, idx, ok := parseRclonePart(obj.GetName()); ok && base == name {
+			parts[idx] = obj
+		}
+	}
+	objRes, ok := newRcloneChunkObject(reqPath, name, parts)
+	if !ok {
+		return nil, errs.ObjectNotFound
+	}
+	return objRes, nil
+}
+
+func newRcloneChunkObject(reqPath, name string, parts map[int]model.Obj) (*chunkObject, bool) {
+	if len(parts) == 0 {
+		return nil, false
+	}
+	idxs := make([]int, 0, len(parts))
+	for i := range parts {
+		idxs = append(idxs, i)
+	}
+	sort.Ints(idxs)
+	names := make([]string, 0, len(idxs))
+	sizes := make([]int64, 0, len(idxs))
+	var total int64
+	var first model.Obj
+	for _, i := range idxs {
+		o := parts[i]
+		if first == nil {
+			first = o
+		}
+		names = append(names, o.GetName())
+		sizes = append(sizes, o.GetSize())
+		total += o.GetSize()
+	}
+	return &chunkObject{
+		Object: model.Object{
+			Path:     reqPath,
+			Name:     name,
+			Size:     total,
+			Modified: first.ModTime(),
+			Ctime:    first.CreateTime(),
+		},
+		chunkSizes: sizes,
+		partNames:  names,
+	}, true
+}
